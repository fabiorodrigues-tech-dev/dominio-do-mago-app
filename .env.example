# 🔑 CONSELHO ELEMENTAL — Variáveis de Ambiente

# ── Supabase (NECESSÁRIO para autenticação e banco de dados) ───────────
# Acesse: https://supabase.com/dashboard → Seu Projeto → Settings → API
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...SUA_CHAVE_ANON_KEY

# ── Feature Flags ──────────────────────────────────────────────────────
# true  = ativa auth Supabase (login obrigatório)
# false = modo offline local (sem login, dados no localStorage)
VITE_ENABLE_SUPABASE_AUTH=false

# ── Integrações Opcionais ──────────────────────────────────────────────
VITE_ENABLE_GOOGLE_CALENDAR=false
VITE_ENABLE_LOCAL_IMPORT=false
VITE_FORCE_BOOTSTRAP_CLOUD_SYNC=false

# URLs das Edge Functions de integração Google Calendar (opcionais)
VITE_GOOGLE_CALENDAR_CONNECT_URL=
VITE_GOOGLE_CALENDAR_SYNC_URL=
